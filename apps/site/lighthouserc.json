{
  "ci": {
    "collect": {
      "startServerCommand": "node ../../scripts/serve-deploy.mjs out --mount /site --port 8102 --compress",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:8102/site",
        "http://localhost:8102/site/docs",
        "http://localhost:8102/site/docs/components/button",
        "http://localhost:8102/site/examples/landing-page",
        "http://localhost:8102/site/examples/admin-dashboard"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 5000, "aggregationMethod": "median" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
            "categories:performance": ["warn", { "minScore": 0.65, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/site$",
          "assertions": {
            "total-byte-weight": ["error", { "maxNumericValue": 1850000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 1300000, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/site/docs$",
          "assertions": {
            "total-byte-weight": ["error", { "maxNumericValue": 600000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 130000, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/site/docs/components/button$",
          "assertions": {
            "total-byte-weight": ["error", { "maxNumericValue": 1900000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 1300000, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/site/examples/landing-page$",
          "assertions": {
            "total-byte-weight": ["error", { "maxNumericValue": 700000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 150000, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/site/examples/admin-dashboard$",
          "assertions": {
            "total-byte-weight": ["error", { "maxNumericValue": 1850000, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 1250000, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
