{
  "name": "@rtkelly-labs/design-system-report",
  "version": "0.1.1",
  "description": "Render a TSX file to one self-contained HTML report, styled by @rtkelly-labs/design-system",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ds-report": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/report.mjs",
    "manifesto": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/report.mjs reports/manifesto.tsx --strict --pdf --no-typecheck --title \"Design Manifesto\"",
    "compendium": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/report.mjs reports/compendium.tsx --strict --pdf --no-typecheck --title Compendium",
    "verify:report-cli": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-report-cli.mjs",
    "check:deps": "knip --no-progress --include dependencies,unlisted,unresolved"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtkelly-labs/design-system.git",
    "directory": "packages/design-system-report"
  },
  "keywords": [
    "html-report",
    "report-generator",
    "tsx",
    "static-html",
    "design-system",
    "tailwind"
  ],
  "author": "Ryan Kelly",
  "license": "MIT",
  "peerDependencies": {
    "@rtkelly-labs/design-system": "workspace:^",
    "@tailwindcss/typography": "^0.5.16",
    "esbuild": "^0.25.0 || ^0.26.0 || ^0.27.0 || ^0.28.0",
    "playwright": "^1.62.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rtkelly-labs/design-system": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.27.7",
    "knip": "^6.32.2",
    "pdfjs-dist": "6.3.289",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
