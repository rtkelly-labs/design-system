{
  "$schema": "https://www.designtokens.org/schema.json",
  "$description": "Midnight — Neon on blue-black. The maximal end of the ladder. Generated from src/theme/levels.ts; do not edit. DTCG 2025.10. Token paths are identical across every level file.",
  "$extensions": {
    "dev.ryankelly.design-system": {
      "level": "midnight",
      "polarity": "dark",
      "specVersion": "2025.10",
      "generatedFrom": "src/theme/levels.ts",
      "contrastFloor": {
        "palette": 5.5,
        "paletteBright": 4.5,
        "role": 4.5
      }
    }
  },
