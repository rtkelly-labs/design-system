{
  "name": "@rtkelly13/design-system",
  "version": "0.7.0",
  "description": "Brutalist design system with a four-level theme ladder, slide deck system, and experiments foundation for Ryan Kelly websites",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./prose.css": "./dist/prose.css",
    "./tokens/midnight.tokens.json": "./tokens/palette.midnight.tokens.json",
    "./tokens/sketch.tokens.json": "./tokens/palette.sketch.tokens.json",
    "./terminal/midnight.itermcolors": "./terminal/rtk-midnight.itermcolors",
    "./terminal/midnight.windows-terminal.json": "./terminal/rtk-midnight.windows-terminal.json",
    "./terminal/midnight.alacritty.toml": "./terminal/rtk-midnight.alacritty.toml",
    "./terminal/midnight.ghostty.conf": "./terminal/rtk-midnight.ghostty.conf",
    "./terminal/sketch.itermcolors": "./terminal/rtk-sketch.itermcolors",
    "./terminal/sketch.windows-terminal.json": "./terminal/rtk-sketch.windows-terminal.json",
    "./terminal/sketch.alacritty.toml": "./terminal/rtk-sketch.alacritty.toml",
    "./terminal/sketch.ghostty.conf": "./terminal/rtk-sketch.ghostty.conf"
  },
  "files": [
    "dist",
    "tokens",
    "terminal",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "skills",
    "!skills/_artifacts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm tokens:build && tsup",
    "tokens:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.mjs",
    "tokens:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.mjs --check",
    "tokens:design": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-design-tokens.mjs",
    "tokens:design:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-design-tokens.mjs --check",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mjs",
    "contrast:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mjs --report",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:css": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-css.mjs",
    "check:css:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-css.mjs --list",
    "check:lint-budget": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-lint-budget.mjs",
    "check:lint-budget:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-lint-budget.mjs --list",
    "check:licences": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-licences.mjs",
    "check:licences:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-licences.mjs --list",
    "licences:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-licences.mjs --update",
    "check:component-docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-docs.mjs",
    "check:component-docs:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-docs.mjs --list",
    "check:doc-snippets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-doc-snippets.mjs",
    "check:doc-snippets:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-doc-snippets.mjs --list",
    "check:skills": "intent validate skills",
    "check:docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs.mjs",
    "check:docs:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs.mjs --list",
    "check:governance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-governance.mjs",
    "check:governance:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-governance.mjs --list",
    "check:component-contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-contract.mjs",
    "check:component-contract:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-component-contract.mjs --list",
    "check:deployed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-deployed.mjs",
    "release:train": "node scripts/release-train.mjs",
    "check:story-conventions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-story-conventions.mjs",
    "check:story-conventions:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-story-conventions.mjs --list",
    "check:docgen-props": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docgen-props.mjs",
    "check:docgen-props:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docgen-props.mjs --list",
    "check:visual-coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-visual-coverage.mjs",
    "check:visual-coverage:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-visual-coverage.mjs --list",
    "check:deps": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-deps.mjs && knip --no-progress --include dependencies,unlisted,unresolved,duplicates",
    "deps:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-deps.mjs --list",
    "knip": "knip --no-progress",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:missing": "playwright test tests/visual.spec.ts --update-snapshots=missing",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots=all",
    "prepublishOnly": "pnpm tokens:build && pnpm build",
    "walkthrough": "playwright test --config=playwright.walkthrough.config.ts",
    "walkthrough:show": "playwright show-report walkthrough-report",
    "check:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api.mjs",
    "api:update": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api.mjs --update",
    "check:fonts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-fonts.mjs",
    "check:fonts:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-fonts.mjs --list",
    "check:tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "check:tokens:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs --list",
    "ansi:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-ansi.mjs",
    "ansi:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-ansi.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtkelly13/design-system.git"
  },
  "keywords": [
    "design-system",
    "brutalist",
    "react",
    "tailwind",
    "storybook",
    "visual-regression",
    "playwright",
    "slides",
    "deck",
    "experiments",
    "theme-ladder",
    "design-tokens",
    "tanstack-intent"
  ],
  "author": "Ryan Kelly",
  "license": "MIT",
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.12",
    "@microcharts/react": "^0.19.1",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "lucide-react": "^1.28.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/intent": "^0.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "4.3.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "intent": {
    "skills": [
      "skills"
    ]
  }
}
